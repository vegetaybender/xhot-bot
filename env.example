BOT_TOKEN=tu_token_de_telegram
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_CREDENTIALS_FILE=
DRIVE_ROOT_FOLDER_ID=1zpDaUJvluGwE8n5YboC2bxViieWaLn9F
WEBHOOK_URL=https://tu-app.up.railway.app
PORT=8080
# Chat IA (opcional, para roleplay). Si no se define, el bot usa respuestas básicas.
# Todos usan API compatible con OpenAI. Elegí UNO y completá KEY + BASE_URL + MODEL.
#
# 1) Aion Labs - GRATIS, SIN TARJETA, modelo de roleplay sin censura
#    Free: 15 req/min, 20.000 tokens/día. Con cualquier recarga pasás a Tier 1:
#    1M tokens/min y tokens diarios ilimitados. Crear key en https://www.aionlabs.ai/app/api-keys/
# CHAT_API_KEY=tu_key_de_aion
# CHAT_BASE_URL=https://api.aionlabs.ai/v1
# CHAT_MODEL=aion-labs/aion-rp-llama-3.1-8b
#
# 2) OpenRouter - modelo sin censura, muy barato (~USD 0.20 / 0.90 por millón de tokens)
#    Crear key en https://openrouter.ai/keys (carga mínima ~USD 5)
# CHAT_API_KEY=sk-or-v1-...
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
#
# 3) xAI Grok - pide tarjeta para habilitar la API (console.x.ai, NO grok.com)
#    Nuevas cuentas: USD 25 de prueba; USD 150/mes si activás data sharing y gastás USD 5
# CHAT_API_KEY=xai-...
# CHAT_BASE_URL=https://api.x.ai/v1
# CHAT_MODEL=grok-4.7
#
# 4) Groq - gratis pero censurado (puede negarse al roleplay)
# CHAT_API_KEY=gsk_...
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=openai/gpt-oss-120b
#
# 5) Ollama local (gratis, sin tarjeta, requiere PC prendida + túnel público)
#    RTX 3090: puede correr dolphin-mistral (24B) o similar sin problema
# CHAT_API_KEY=ollama
# CHAT_BASE_URL=https://tu-tunel.trycloudflare.com/v1
# CHAT_MODEL=dolphin-mistral
#
# Opcional: forzar lista de modelos de respaldo (separados por coma)
# CHAT_MODEL_FALLBACKS=modelo-1,modelo-2
#
# Opcional: rotar entre varias keys del mismo proveedor (separadas por coma).
# Si una key se queda sin cuota (429), el bot prueba automáticamente la siguiente.
# CHAT_API_KEYS=key1,key2,key3

# Nivel de explicitud por defecto: suave | medio | alto (alias: extremo, max)
# (también se puede cambiar desde el chat con /nivel)
# CHAT_EXPLICIT_LEVEL=alto

# Roles por defecto: novia (sumisa), amante (espontánea y erótica), vip (paga y dominante).
# Se pueden cambiar desde el chat con /rol novia, /rol amante o /rol vip.

# Visión (opcional): describe las fotos para que el roleplay sepa qué se envía.
# Gemini free tier, sin tarjeta: https://aistudio.google.com/app/apikey
# Si no se configura, se usa el nombre del archivo como referencia.
# VISION_API_KEY=...
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_MODEL=gemini-3.5-flash-lite
# Si el modelo configurado falla (503, 429, timeout), el bot prueba
# automáticamente: gemini-3.5-flash-lite -> gemini-3.6-flash -> gemini-3.8-flash.

# (Compatibilidad con variables anteriores)
# CHAT_API_KEY=
# CHAT_BASE_URL=https://api.aionlabs.ai/v1
# CHAT_MODEL=aion-labs/aion-rp-llama-3.1-8b
# GROK_API_KEY=
# GROK_MODEL=grok-4.7
# GROK_BASE_URL=https://api.x.ai/v1
